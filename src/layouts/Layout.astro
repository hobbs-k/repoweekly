---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/vt323/latin-400.css';
import '../styles/global.css';
import { config } from '../../scripts/lib/config.js';
import { href } from '../lib/format.js';
import PixelR from '../components/PixelR.astro';
import Icon from '../components/Icon.astro';
import GitHubMark from '../components/GitHubMark.astro';

const { title, description, current = '' } = Astro.props;
// Share previews (X, LinkedIn, Slack, WhatsApp...) need absolute addresses.
const pageUrl = new URL(Astro.url.pathname, new URL(config.site.url).origin).href;
const shareImage = `${config.site.url}/og.png`;
const nav = [
  { href: href('/'), label: 'This week', key: 'home' },
  { href: href('/rising/'), label: 'Rising', key: 'rising' },
  { href: href('/skills/'), label: 'Skills', key: 'skills' },
  { href: href('/contribute/'), label: 'Contribute', key: 'contribute' },
  { href: href('/weeks/'), label: 'Archive', key: 'archive' },
  { href: href('/compare/'), label: 'Compare', key: 'compare' },
  { href: href('/terminal/'), label: 'Terminal', key: 'terminal' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RepoWeekly" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RepoWeekly: top GitHub repos of the week, rising AI agent skills, beginner issues" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="sitemap" type="application/xml" href={href('/sitemap.xml')} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="RepoWeekly" href={href('/feed.xml')} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="mast">
      <div class="wrap mast-row">
        <a class="brand" href={href('/')}><PixelR /><span>Repo<span class="brand-w">Weekly</span></span></a>
        <p class="status"><a class="gh-link" href="https://github.com/hobbs-k/repoweekly" rel="noopener"><GitHubMark /> Built on GitHub data</a><span aria-hidden="true"> / free / no ads / no tracking</span></p>
      </div>
      <nav class="nav" aria-label="Main">
        <div class="wrap">
          <ul>
            {nav.map((n, i) => (
              <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}><span class="fkey" aria-hidden="true">F{i + 1}</span> <Icon name={n.key === 'home' ? 'home' : n.key} /> {n.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>RepoWeekly is free. It has no ads, no paywall and no tracking.</p>
        <ul>
          <li><a href={href('/api/latest.json')}>Latest week as JSON</a></li>
          <li><a href={href('/api/index.json')}>All weeks</a></li>
          <li><a href={href('/feed.xml')}>RSS feed</a></li>
          <li><a href={href('/about/')}>About</a></li>
          <li><a href={href('/health/')}>Dead or alive?</a></li>
          <li><a href={href('/api-docs/')}>API</a></li>
          <li><a href="https://www.linkedin.com/in/njw422/" rel="noopener me">LinkedIn</a></li>
        </ul>
        <p class="gh-note"><GitHubMark size={20} /> <span>All numbers come from the GitHub API. RepoWeekly is an independent project and is not affiliated with or endorsed by GitHub. <a href="https://github.com/hobbs-k/repoweekly" rel="noopener">Source code and issues on GitHub</a>.</span></p>
        <p>{config.licenseNote}</p>
      </div>
    </footer>
    <button type="button" class="to-top" hidden aria-label="Back to top">↑ Top</button>
    <script is:inline defer src={href('/js/scroll.js')}></script>
    <slot name="scripts" />
  </body>
</html>
