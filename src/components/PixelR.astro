---
// The RepoWeekly mark: a blocky "R" with an amber cursor. Colours come from the theme.
const { height = 28 } = Astro.props;
---
<svg class="pixel-r" width={height * 60 / 56} height={height} viewBox="0 0 60 56" aria-hidden="true" focusable="false">
  <g fill="var(--phos)"><rect x="0" y="0" width="10" height="56"/><rect x="10" y="0" width="26" height="10"/><rect x="10" y="24" width="26" height="10"/><rect x="34" y="10" width="10" height="14"/><rect x="24" y="34" width="10" height="10"/><rect x="34" y="44" width="10" height="12"/></g>
  <rect class="pixel-cursor" x="48" y="46" width="10" height="10" fill="var(--mark)"/>
</svg>
