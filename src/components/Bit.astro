---
// Bit, the RepoWeekly mascot: a 16x16 pixel robot. Its eyes blink and its antenna light pulses (CSS only).
const { size = 96, say = '' } = Astro.props;
---
<figure class="bit" aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 16 16" shape-rendering="crispEdges">
    <rect class="bit-light" x="7" y="0" width="2" height="2" fill="var(--mark)" />
    <rect x="7.5" y="2" width="1" height="1" fill="var(--phos)" />
    <rect x="3" y="3" width="10" height="7" fill="var(--phos)" />
    <g class="bit-eyes" fill="var(--ground)"><rect x="5" y="5" width="2" height="2" /><rect x="9" y="5" width="2" height="2" /></g>
    <rect x="6" y="8" width="4" height="1" fill="var(--ground)" />
    <rect x="5" y="10" width="6" height="1" fill="var(--phos)" />
    <rect x="3" y="11" width="10" height="3" fill="var(--phos)" />
    <rect x="5" y="12" width="6" height="1" fill="var(--ground)" />
    <rect x="1" y="11" width="2" height="2" fill="var(--phos)" /><rect x="13" y="11" width="2" height="2" fill="var(--phos)" />
    <rect x="5" y="14" width="2" height="2" fill="var(--phos)" /><rect x="9" y="14" width="2" height="2" fill="var(--phos)" />
  </svg>
  {say && <figcaption class="bit-say">{say}</figcaption>}
</figure>
