---
// "What people are saying": quotes about one repo from Hacker News and hand-picked X posts.
// Saved by scripts/buzz.js, so the page shows them without the visitor contacting either site.
const { buzz } = Astro.props;
const quotes = buzz?.quotes ?? [];
const where = { hn: 'on Hacker News', x: 'on X' };
const safe = (u) => /^https:\/\/(news\.ycombinator\.com|x\.com)\//.test(u);
---
{buzz && (buzz.story || quotes.length > 0) && (
  <div class="buzz">
    <p class="method-title">What people are saying</p>
    {buzz.story && safe(buzz.story.url) && (
      <p class="muted buzz-story">Discussed on Hacker News: <a href={buzz.story.url} rel="noopener">{buzz.story.title}</a> ({buzz.story.points} points, {buzz.story.comments} comments)</p>
    )}
    {quotes.length > 0 && (
      <ul class="buzz-quotes">
        {quotes.filter((q) => safe(q.url)).map((q) => (
          <li>
            <span class="avatar avatar-mono buzz-avatar" aria-hidden="true">{q.author.charAt(0).toUpperCase()}</span>
            <blockquote>
              <p>“{q.text}”</p>
              <footer>{q.author}{q.handle && q.handle !== q.author ? ` (@${q.handle})` : ''} {where[q.source]}{q.date ? `, ${q.date}` : ''}. <a href={q.url} rel="noopener">Read it there</a></footer>
            </blockquote>
          </li>
        ))}
      </ul>
    )}
    <p class="muted buzz-note">Quotes are copied from public posts that name this repository. They are people's opinions, not ours.</p>
  </div>
)}
