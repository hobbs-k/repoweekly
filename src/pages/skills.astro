---
import Layout from '../layouts/Layout.astro';
import SkillEntry from '../components/SkillEntry.astro';
import RisingSkill from '../components/RisingSkill.astro';
import { loadSkills } from '../lib/data.js';
import { href } from '../lib/format.js';

const data = loadSkills();
const top = data?.repos.slice(0, 10) ?? [];
const rising = data?.rising ?? [];
const agentChoices = [['claude', 'Claude Code'], ['codex', 'Codex'], ['cursor', 'Cursor'], ['copilot', 'GitHub Copilot'], ['gemini', 'Gemini CLI'], ['opencode', 'OpenCode'], ['windsurf', 'Windsurf'], ['claudeai', 'Claude.ai']];
const asOf = data ? new Date(`${data.date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
---

<Layout title="Rising AI agent skills, checked before you install | RepoWeekly" description="Skill repositories for Claude Code, Codex, Cursor and other AI coding agents that are growing fast, each checked against eight tools' rules, with script warnings and version-pinned install commands." current="skills">
  <div class="wrap">
    <section class="intro">
      <p class="prompt" aria-hidden="true"><span>$</span> repoweekly skills --rising --checked</p>
      <h1>Rising AI agent skills, checked before you install</h1>
      <p class="lede">A skill is a folder with a <code>SKILL.md</code> file that teaches an AI coding agent one task. We find the skill repositories that are growing fast, before everyone knows them, and check each one so you know what you are installing.</p>
      <ul class="promise">
        <li><strong>Early.</strong> New repositories picking up stars fast, found every day.</li>
        <li><strong>Checked.</strong> Each skill is tested against the documented rules of eight coding tools, and scripts that can run on your computer are flagged.</li>
        <li><strong>Pinned.</strong> Install commands for your tool, fixed to the exact version we checked.</li>
      </ul>
      {rising.length > 0 && <p><a class="jump" href="#rising-title">See today's rising skills <span aria-hidden="true">↓</span></a></p>}
      <p class="notice"><strong>Read before you install.</strong> A skill can run commands and change files on your computer. Read the skill first, and only use ones you trust.</p>
    </section>

    {rising.length > 0 && (
      <section class="rising" aria-labelledby="rising-title">
        <div class="section-head">
          <h2 id="rising-title">Rising skills</h2>
          <p>Newer skill repositories that are picking up stars fast, before everyone knows them.{' '}
            {rising[0].rising_basis === 'growth' ? 'Ranked by stars gained lately compared with their size.' : 'For now they are ranked by stars a day since they were created. Once we have a few days of history this switches to stars gained lately.'}{' '}
            Each one has install commands for your tool, taken from its real file layout and pinned to one version.</p>
        </div>
        <div class="agent-pick" role="group" aria-label="Which tool do you use?" hidden>
          <span class="muted">I use:</span>
          <div class="chips">{agentChoices.map(([id, label]) => <button type="button" data-agent={id} aria-pressed="false">{label}</button>)}</div>
        </div>
        <ol class="entries" aria-label="Rising skill repositories">
          {rising.map((item) => <RisingSkill item={item} asOf={data.date} />)}
        </ol>
      </section>
    )}

    <div class="section-head">
      <h2>Most popular</h2>
      <p>The big, well-known skill repositories.{data && data.mode === 'gain' ? ` Ranked by stars gained in the last ${data.span_days} days.` : ' Ranked by total stars until we have a few days of history.'} As of {asOf}.</p>
      <p class="muted">Looking for every skill, or install counts? <a href="https://www.skills.sh/" rel="noopener">skills.sh</a> lists over a million skills, ranked by installs through its own installer.</p>
    </div>
    {top.length > 0 ? (
      <ol class="entries" aria-label="Top skill repositories">
        {top.map((item) => <SkillEntry item={item} mode={data.mode} span={data.span_days} asOf={data.date} />)}
      </ol>
    ) : (
      <p class="notice">The first skills list appears after the next daily run.</p>
    )}

    {data && (
      <section aria-labelledby="find-title">
        <div class="section-head" id="find">
          <h2 id="find-title">Find a skill</h2>
          <p>Search all {data.repos.length} skill repositories we track by what you need, such as <em>pdf</em>, <em>testing</em> or <em>security</em>. The search runs in your browser.</p>
        </div>
        <form class="skills-form skill-finder" data-src={href('/api/skills.json')} hidden>
          <label class="skills-field">What do you need?
            <input type="text" name="q" autocomplete="off" placeholder="pdf, security audit, react" />
          </label>
          <div class="chips" role="group" aria-label="Agents"></div>
        </form>
        <p class="issues-status muted" role="status"></p>
        <ol class="issues skill-results" hidden></ol>
        <p><button type="button" class="more" hidden>Show more</button></p>
        <noscript><p>The search needs JavaScript. <a href={href('/api/skills.json')}>The same list is in this JSON file.</a></p></noscript>
      </section>
    )}

    <h2 class="plain-h">How this list is made</h2>
    <div class="page-text">
      <p>Every day we search GitHub for repositories tagged with skill topics, then read each one's file list and keep only those that really contain <code>SKILL.md</code> files. Stars belong to the whole repository, so the ranking is by repository. Inside each one we list the skills it holds.</p>
      <p>The summaries are written by an AI from each README, so check the repository before you rely on them. The agent names (Claude, Codex, Cursor and so on) are guessed from the repository's name, description and topics, not tested.</p>
    </div>
  </div>
  <script slot="scripts" is:inline defer src={href('/js/skills.js')}></script>
</Layout>
