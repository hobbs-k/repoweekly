---
import Layout from '../layouts/Layout.astro';
import WeekView from '../components/WeekView.astro';
import { loadGuide, loadLatestWeek } from '../lib/data.js';
import { href, weekNumber } from '../lib/format.js';

const w = loadLatestWeek();
const year = w.start.slice(0, 4);
---

<Layout
  title={`RepoWeekly: top GitHub repositories, week ${weekNumber(w.week)} of ${year}`}
  description={`The ${w.top.length} GitHub repositories that gained the most stars in week ${weekNumber(w.week)} of ${year}, each explained in plain language.`}
  current="home"
>
  <div class="wrap">
    <WeekView week={w} heading="The ten repositories that gained the most stars this week" guide={loadGuide(w.week)} />
  </div>
  <script slot="scripts" is:inline defer src={href('/js/filters.js')}></script>
</Layout>
