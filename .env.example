# Copy to .env for local runs. Never commit .env.
GITHUB_TOKEN=
# Any OpenAI-style AI service. Default is NVIDIA (free key at https://build.nvidia.com). Also set LLM_API_BASE and LLM_MODEL for another service.
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE=
# Data folder. Use fixtures/data to run against the fake dataset.
DATA_DIR=data
# Phase 3: set to true to add Urdu summaries.
URDU_ENABLED=false
