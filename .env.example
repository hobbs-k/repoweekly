# Copy to .env for local runs. Never commit .env.
GITHUB_TOKEN=
# Free key from https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
GEMINI_MODEL=
# Data folder. Use fixtures/data to run against the fake dataset.
DATA_DIR=data
# Phase 3: set to true to add Urdu summaries.
URDU_ENABLED=false
